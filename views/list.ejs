<%- include("header") -%>
<body>
    <div class="container">

   
    <h1 class="header"> <%= listTitle %> </h1>
    <ul class="list">
        
        

       <!-- <% for (let i = 0; i < newListItems.length; i++) { %>
           <li> <%= newListItems[i] %></li> 
    
 <%   }  %> -->

        
  <% newListItems.forEach((item, index) => { %>
    <form action="/delete" method="post">
      <li class="list-div">
        <input type="checkbox" id="item-<%= index %>" name="checkbox" value="<%= item._id %>" onchange="this.form.submit()">
        <label for="item-<%= index %>"><%= item.name %></label>
      </li>
      <input type="hidden" name="listName" value="<%= listTitle %>"> </input>
    </form>
  <% }) %>
</ul>


 
    <form action="/" method="post" >
        <input type="text" name="lists" autocomplete="off" required>
        <button type="submit" name="list" value="<%= listTitle %>">submit</button>
    </form>
     </div>
   
     <%- include("footer") -%>
</body>
</html>


